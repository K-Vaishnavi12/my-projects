{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Orders / sec (last 1m)",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{application=\"order-service\",uri=\"/api/v1/orders\",method=\"POST\"}[1m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green"}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "type": "stat",
      "title": "Order p99 latency",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by(le) (rate(http_server_requests_seconds_bucket{application=\"order-service\"}[1m])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "stat",
      "title": "Inventory Reserved (total)",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "inventory_reserved_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Inventory Failed (total)",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "inventory_failed_total", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "red"}]}}}
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Service",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 6},
      "targets": [
        {"expr": "sum by(application) (rate(http_server_requests_seconds_count[1m]))", "refId": "A", "legendFormat": "{{application}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used by Service",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum by(application) (jvm_memory_used_bytes{area=\"heap\"})", "refId": "A", "legendFormat": "{{application}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ecommerce"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
