# ============================================================
# Streamlit Cloud secrets template
# ============================================================
# On Streamlit Cloud, go to your app -> Settings -> Secrets
# and paste the contents below (with real values). Streamlit
# exposes each entry as an env var to your app.
# ============================================================

GROQ_API_KEY = "gsk_your_actual_groq_key"
GROQ_MODEL = "llama-3.3-70b-versatile"

MONGODB_URI = "mongodb+srv://symposium:YourPassword@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB = "symposium"

LLM_PROVIDER = "groq"
USE_LOCAL_VECTOR_STORE = "false"

EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM = "384"

CHUNK_SIZE = "500"
CHUNK_OVERLAP = "80"
MAX_ARTICLES_PER_TOPIC = "10"

MAX_TURNS_PER_DEBATE = "6"
RETRIEVAL_TOP_K = "5"
CONSENSUS_THRESHOLD = "0.75"

SQLITE_PATH = "data/processed/symposium_dwh.sqlite"
RAW_DATA_DIR = "data/raw"
STAGING_DATA_DIR = "data/staging"
PROCESSED_DATA_DIR = "data/processed"
MODEL_DIR = "data/models"
EXPORT_DIR = "data/exports"
