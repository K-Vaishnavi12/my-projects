# ============================================================
# Symposium - environment configuration (copy to .env)
# ============================================================

# ---- LLM provider ----
# Options: 'groq' (default, fast + generous free tier) or 'gemini'
LLM_PROVIDER=groq

# ---- Groq ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Google Gemini (optional) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- MongoDB Atlas (free M0 cluster is enough) ----
# https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=symposium

# When true, use FAISS locally instead of Atlas Vector Search
USE_LOCAL_VECTOR_STORE=false

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Data warehouse ----
SQLITE_PATH=data/processed/symposium_dwh.sqlite

# ---- Paths ----
RAW_DATA_DIR=data/raw
STAGING_DATA_DIR=data/staging
PROCESSED_DATA_DIR=data/processed
MODEL_DIR=data/models
EXPORT_DIR=data/exports

# ---- ETL knobs ----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MAX_ARTICLES_PER_TOPIC=40

# ---- Debate runtime ----
MAX_TURNS_PER_DEBATE=6
RETRIEVAL_TOP_K=5
CONSENSUS_THRESHOLD=0.75

# ---- AWS (optional; only needed for deploy scripts) ----
AWS_REGION=ap-south-1
AWS_S3_BUCKET=symposium-raw-staging
