# Copy to .env and fill in your MySQL credentials.
# Either set the full URL...
# PATIENTFLOW_DB_URL=mysql+pymysql://root:yourpassword@127.0.0.1:3306/patientflow?charset=utf8mb4

# ...or the individual parts (used when PATIENTFLOW_DB_URL is not set):
PATIENTFLOW_DB_HOST=127.0.0.1
PATIENTFLOW_DB_PORT=3306
PATIENTFLOW_DB_USER=root
PATIENTFLOW_DB_PASSWORD=
PATIENTFLOW_DB_NAME=patientflow
